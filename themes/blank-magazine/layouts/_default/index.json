{{- $pages := where .Site.RegularPages "Section" "in" (slice "posts" "gallery") -}}
{{- $index := slice -}}
{{- range $pages -}}
  {{- $item := dict
    "title" .Title
    "permalink" .RelPermalink
    "section" .Section
    "date" (.Date.Format "2006-01-02")
    "summary" (.Summary | plainify | htmlUnescape)
    "content" (.Plain | htmlUnescape)
    "author" (.Params.author | default "")
    "tags" (.Params.tags | default slice)
    "categories" (.Params.categories | default slice)
    "cover" (.Params.cover | default "")
  -}}
  {{- $index = $index | append $item -}}
{{- end -}}
{{- $index | jsonify -}}
